    "openrouter:meta-llama/llama-3.1-8b-instruct",
    "openrouter:qwen/qwen3-8b"
  ],
  "policies": [
    "NOMEM",
    "P0",
    "P1:ttl_days=20",
    "P2",
    "P3",
    "P4",
    "P5"
  ],
  "request_extras": {
    "openrouter:openai/gpt-6.1-sol": {
      "reasoning": {
        "effort": "low"
      }
    },
    "openrouter:google/gemini-3.8-flash": {
      "reasoning": {
        "effort": "low"
      }
    },
