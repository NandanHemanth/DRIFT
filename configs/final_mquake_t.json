      }
    },
    "openrouter:deepseek/deepseek-v4.1-flash": {
      "reasoning": {
        "enabled": false
      }
    }
  },
  "answer_max_tokens": {
    "openrouter:openai/gpt-6.1-sol": 4096,
    "openrouter:google/gemini-3.8-flash": 4096,
    "openrouter:qwen/qwen3-8b": 4096
  },
  "qa_workers": 4,
