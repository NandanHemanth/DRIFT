{
  "_comment": "P2 grace sweep with history probes. Retrieval level is free; --answers adds the two small models and the fixed judge.",
  "results_dir": "artifacts/results/grace_history",
  "embedder": "ollama:nomic-embed-text",
  "retrieval_k": 25,
  "functional_predicates": "*",
  "relation_matching": "normalized",
  "grace_grid": [
    0,
    1,
    3,
    5,
    7,
    10,
    14,
    21,
    "never"
  ],
  "benchmarks": [
    {
      "name": "mquake_t",
      "dataset": "data/mquake_t_sh.json",
      "extract_model": [
        "nvidia:z-ai/glm-5.2",
        "nvidia:minimaxai/minimax-m3",
        "cerebras:gpt-oss-120b",
        "groq:llama-3.3-70b-versatile",
        "hf:meta-llama/Llama-3.1-8B-Instruct",
        "mistral:mistral-small-latest"
      ]
    },
    {
      "name": "factconsolidation",
      "dataset": "data/factconsolidation_sh_6k.json",
      "extract_model": [
        "nvidia:z-ai/glm-5.2",
        "nvidia:minimaxai/minimax-m3",
        "cerebras:gpt-oss-120b",
        "groq:llama-3.3-70b-versatile",
        "hf:meta-llama/Llama-3.1-8B-Instruct",
        "mistral:mistral-small-latest"
      ]
    },
    {
      "name": "convomem",
      "dataset": "data/convomem_changing.json",
      "extract_model": [
        "openrouter:z-ai/glm-5.2",
        "openrouter:openai/gpt-oss-120b",
        "openrouter:meta-llama/llama-3.3-70b-instruct"
      ]
    }
  ],
  "answer_models": [
    "openrouter:meta-llama/llama-3.1-8b-instruct",
    "openrouter:qwen/qwen3-8b"
  ],
  "judge_model": "openrouter:deepseek/deepseek-v4.1-flash",
  "request_extras": {
    "openrouter:meta-llama/llama-3.1-8b-instruct": {
      "provider": {
        "order": [
          "DeepInfra"
        ],
        "allow_fallbacks": false
      }
    },
    "openrouter:qwen/qwen3-8b": {
      "provider": {
        "order": [
          "Alibaba"
        ],
        "allow_fallbacks": false
      },
      "reasoning": {
        "enabled": true
      }
    },
    "openrouter:deepseek/deepseek-v4.1-flash": {
      "reasoning": {
        "enabled": false
      }
    }
  },
  "answer_max_tokens": {
    "openrouter:qwen/qwen3-8b": 4096
  },
  "qa_workers": 4,
  "rpm_overrides": {
    "openrouter": 120
  },
  "extract_retry_tokens": 4096
}